Options -Indexes
<FilesMatch "^(config(?:_sample)?\.php|schema\.sql|composer\.(?:json|lock)|storage\.php|MultiplayerSocket\.php|ws-server\.php)$">
Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^vendor(?:/|$) - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(connect|telemetry|nearby|events|disconnect|heartbeat|health)/?$ index.php [L,QSA]
RewriteRule ^api/?$ api.php [L,QSA]
RewriteRule ^tutorial/?$ tutorial.php [L,QSA]
